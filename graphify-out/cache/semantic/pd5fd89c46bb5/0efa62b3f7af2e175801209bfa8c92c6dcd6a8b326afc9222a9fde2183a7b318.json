{"nodes": [{"id": "docs_lld_erp_manufaktur_pipa_lld_document", "label": "LLD ERP + MES Manufaktur Pipa v2.0", "file_type": "document", "source_file": "docs/LLD-ERP-Manufaktur-Pipa.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_lld_erp_manufaktur_pipa_naming_convention", "label": "Naming & Data-Type Convention", "file_type": "rationale", "source_file": "docs/LLD-ERP-Manufaktur-Pipa.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Status columns use VARCHAR(30) plus a PHP Enum constant instead of a MySQL ENUM so new statuses can be added without an ALTER; measurements use DECIMAL rather than int/double to avoid float drift on lengths and weights."}, {"id": "docs_lld_erp_manufaktur_pipa_status_state_machine", "label": "Standard Status Workflow & State Machine", "file_type": "concept", "source_file": "docs/LLD-ERP-Manufaktur-Pipa.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every document follows DRAFT\u2192SUBMITTED\u2192APPROVED\u2192RELEASED\u2192PARTIAL\u2192COMPLETED\u2192CLOSED with per-document state classes; an illegal transition returns HTTP 409 so concurrent or stale UI actions cannot corrupt document state."}, {"id": "docs_lld_erp_manufaktur_pipa_response_envelope", "label": "API Response Envelope & Business Error Codes", "file_type": "concept", "source_file": "docs/LLD-ERP-Manufaktur-Pipa.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "422 for validation/business rules, 409 for state conflict and optimistic lock, 403 for permission, 423 specifically for accounting period lock \u2014 distinct codes let the frontend render the right i18n message from a single ErrorCodes registry."}, {"id": "docs_lld_erp_manufaktur_pipa_modular_monolith", "label": "Modular Monolith Structure (app/Modules + Core)", "file_type": "rationale", "source_file": "docs/LLD-ERP-Manufaktur-Pipa.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Modules communicate only through Service interfaces or Events \u2014 a controller may never touch another module's Model directly \u2014 so the monolith keeps module boundaries enforceable without paying the cost of separate services."}, {"id": "docs_lld_erp_manufaktur_pipa_numberingservice", "label": "NumberingService (race-safe document numbers)", "file_type": "concept", "source_file": "docs/LLD-ERP-Manufaktur-Pipa.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Numbers are allocated inside a transaction with lockForUpdate on the doc_numberings row and reset monthly by (doc_type, period), guaranteeing gapless unique doc_no under concurrency."}, {"id": "docs_lld_erp_manufaktur_pipa_approvalengine", "label": "ApprovalEngine", "file_type": "concept", "source_file": "docs/LLD-ERP-Manufaktur-Pipa.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Approval levels are generated from approval_flows keyed by doc_type and value range, so escalation thresholds are configuration; rejection marks the document REJECTED and SKIPs remaining levels rather than deleting rows, preserving the audit trail."}, {"id": "docs_lld_erp_manufaktur_pipa_taxengine", "label": "TaxEngine (calcVat)", "file_type": "concept", "source_file": "docs/LLD-ERP-Manufaktur-Pipa.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rates are resolved by effective date on the tax code; rounding is half-up to whole rupiah at document level (not per line) with the residual pushed to the last line, so the printed invoice total always reconciles."}, {"id": "docs_lld_erp_manufaktur_pipa_journalengine", "label": "JournalEngine (post)", "file_type": "concept", "source_file": "docs/LLD-ERP-Manufaktur-Pipa.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Posting reads acc_journal_setup for Dr/Cr mapping per ref type, refuses a locked period with 423, asserts \u03a3D=\u03a3K, and is made idempotent by a unique key on (ref_type, ref_id, journal_type) so a retried job cannot double-post."}, {"id": "docs_lld_erp_manufaktur_pipa_uomconversionservice", "label": "UomConversionService", "file_type": "concept", "source_file": "docs/LLD-ERP-Manufaktur-Pipa.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "For pipe RM the kg-per-mm factor is derived per serial from its own remaining weight and length, not from the master std_length/std_weight; master factors are used only for PO and MRP estimation, because real bars deviate from nominal."}, {"id": "docs_lld_erp_manufaktur_pipa_serialservice", "label": "SerialService (generateForGrLine, actualize, consume)", "file_type": "concept", "source_file": "docs/LLD-ERP-Manufaktur-Pipa.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "consume() deducts length and a proportionally computed kg from the serial and updates under an optimistic lock (WHERE id=? AND version=?), so two concurrent shop-floor scans on the same bar cannot both succeed on stale data."}, {"id": "docs_lld_erp_manufaktur_pipa_quotaservice", "label": "QuotaService (reserve / actualize)", "file_type": "concept", "source_file": "docs/LLD-ERP-Manufaktur-Pipa.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Balance is recomputed as total + SUM(ton*sign) under SELECT \u2026 FOR UPDATE on the m_quota row, serialising all reserve/actualize access; movements are stored as signed ledger rows rather than a mutable balance so the quota card is fully auditable."}, {"id": "docs_lld_erp_manufaktur_pipa_scrapservice", "label": "ScrapService (evaluate / decide)", "file_type": "concept", "source_file": "docs/LLD-ERP-Manufaktur-Pipa.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The minimum usable length is the MIN(length_per_pcs_mm) across all APPROVED BOMs using that component, cached for an hour and invalidated on BOM change, because recomputing it on every serial consumption would be a hot query on the shop floor."}, {"id": "docs_lld_erp_manufaktur_pipa_mesdispatchservice", "label": "MesDispatchService.resolve (TR_CUT vs TR_PRO)", "file_type": "concept", "source_file": "docs/LLD-ERP-Manufaktur-Pipa.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dispatch is decided by (sequence == 1 AND process.is_cutting): only the first cutting step scans RM serials; every other step \u2014 including a later cutting step \u2014 scans WIP pallet codes, because after step 1 the physical unit of handling is a pallet, not a bar."}, {"id": "docs_lld_erp_manufaktur_pipa_trcutservice", "label": "TrCutService.record", "file_type": "concept", "source_file": "docs/LLD-ERP-Manufaktur-Pipa.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exactly one operator is enforced structurally by putting user_id on the main row (not a child table), while machines are a detail table since cutting is legitimately multi-machine."}, {"id": "docs_lld_erp_manufaktur_pipa_trproservice", "label": "TrProService.record", "file_type": "concept", "source_file": "docs/LLD-ERP-Manufaktur-Pipa.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each output pallet stores from_pallet_label and the source pallet flips to MOVED, giving a complete pallet-to-pallet chain across processes without needing per-piece serials after cutting."}, {"id": "docs_lld_erp_manufaktur_pipa_woallocationservice", "label": "WoAllocationService.book (serial booking to WO)", "file_type": "concept", "source_file": "docs/LLD-ERP-Manufaktur-Pipa.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Booking pre-computes qty_per_serial = floor(remaining_length / length_per_pcs) plus projected remnant and scrap-candidate flags, so the operator only scans a prepared list; a booked serial is locked out of other WOs until released."}, {"id": "docs_lld_erp_manufaktur_pipa_pallet_wip", "label": "WIP Pallet Traceability (prd_wip_pallet)", "file_type": "concept", "source_file": "docs/LLD-ERP-Manufaktur-Pipa.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_lld_erp_manufaktur_pipa_putaway_layout", "label": "Putaway & Visual Warehouse Layout", "file_type": "concept", "source_file": "docs/LLD-ERP-Manufaktur-Pipa.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rack assignment after GR confirm feeds a drag-drop visual layout so remnant stock is always locatable \u2014 the stated fix for the legacy wh_rem behaviour where leftovers had no clear rack."}, {"id": "docs_lld_erp_manufaktur_pipa_legacy_schema_fixes", "label": "Fixes vs Reference Application Schema", "file_type": "rationale", "source_file": "docs/LLD-ERP-Manufaktur-Pipa.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Five deliberate corrections to the legacy design: integer FK to wh_serial.id instead of string serial numbers scattered everywhere; dual UoM (length AND kg, reference tracked length only); explicit status workflow instead of a boolean `finish` flag; DECIMAL for measurements instead of int/double; plus scan idempotency and standard audit columns."}, {"id": "docs_lld_erp_manufaktur_pipa_item_customer_validation", "label": "Item\u2013Customer Mapping Validation (m_item_customer)", "file_type": "concept", "source_file": "docs/LLD-ERP-Manufaktur-Pipa.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces the legacy single m_item.cus_id column with a mapping table: an SO line is rejected (422 ITEM_CUSTOMER_NOT_ALLOWED) unless the item is registered for that customer, and the same row supplies customer_part_no and qty_per_box for DO and packing labels."}, {"id": "docs_lld_erp_manufaktur_pipa_grn_serial_flow", "label": "GRN Serial Flow (generate \u2192 print \u2192 actualize \u2192 confirm)", "file_type": "concept", "source_file": "docs/LLD-ERP-Manufaktur-Pipa.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AP invoice entry is deliberately gated until after GR confirm so the 3-way match runs against actual received qty, weight and length rather than PO estimates."}, {"id": "docs_lld_erp_manufaktur_pipa_mrp_engine", "label": "MRP Engine (low-level-code explosion)", "file_type": "concept", "source_file": "docs/LLD-ERP-Manufaktur-Pipa.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Items are levelled by low-level code so an FG acting as PM is only netted after its parent; v1 simplifies pipe RM on-hand to kg plus std_length-equivalent bars rather than exact offcut packing, and import RM net kg is converted to ton and compared with quota balance to warn about quota shortage."}, {"id": "docs_lld_erp_manufaktur_pipa_crp_engine", "label": "CRP Loading Calculation", "file_type": "concept", "source_file": "docs/LLD-ERP-Manufaktur-Pipa.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Load is allocated to priority-1 machines first and cascades to the next priority on overload; residual overload is only flagged (suggesting OT, subcont or shifting MPS) rather than auto-resolved, keeping the planner in the loop."}, {"id": "docs_lld_erp_manufaktur_pipa_cogm_calculation", "label": "COGM Calculation & Roll-Up per WO", "file_type": "concept", "source_file": "docs/LLD-ERP-Manufaktur-Pipa.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "COGM = material + labor + FOH + subcont \u2212 recovery, with material taken from actual serial movement kg \u00d7 landed unit cost; an FG-as-PM lot is carried into the parent WO as material, which is what makes multi-level roll-up work."}, {"id": "docs_lld_erp_manufaktur_pipa_fcs_rfg_flow", "label": "FCS \u2192 RFG Receiving Flow", "file_type": "concept", "source_file": "docs/LLD-ERP-Manufaktur-Pipa.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FCS creation validates that every operation is COMPLETED and all NG dispositioned before an FG lot may be received, and freezes a traceability JSON of serials used and operations performed."}, {"id": "docs_lld_erp_manufaktur_pipa_offline_terminal", "label": "Offline Terminal Design (service worker + IndexedDB queue)", "file_type": "concept", "source_file": "docs/LLD-ERP-Manufaktur-Pipa.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Critical validations run locally against a WO/BOM/WOS snapshot downloaded at menu loading; the queue flushes in order per WO and a duplicate client_uuid returns 200 with meta.duplicate=true instead of erroring, so replay is safe. Offline is capped at 24 hours before a re-sync is forced, bounding how stale local validation data can be."}, {"id": "docs_lld_erp_manufaktur_pipa_idempotency_client_uuid", "label": "client_uuid Idempotency Key", "file_type": "concept", "source_file": "docs/LLD-ERP-Manufaktur-Pipa.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_lld_erp_manufaktur_pipa_optimistic_lock", "label": "Optimistic Locking & Explicit Row Locks", "file_type": "concept", "source_file": "docs/LLD-ERP-Manufaktur-Pipa.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "High-contention resources (quota, numbering, serial, wh_stock_sum) get explicit pessimistic locks inside DB::transaction, while user-facing document edits use a version column sent from the frontend \u2014 pessimistic where writes are short and hot, optimistic where a human holds the record open."}, {"id": "docs_lld_erp_manufaktur_pipa_security_design", "label": "Security Design (Sanctum, 2FA, vendor guard, period lock)", "file_type": "concept", "source_file": "docs/LLD-ERP-Manufaktur-Pipa.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Privileges are re-checked in the service layer as well as route middleware (defense in depth); the vendor portal uses a separate guard with a global vendor_id scope and shares no endpoint with internal users; MES terminal tokens are long-lived but bound to terminal_id plus an IP allowlist."}, {"id": "docs_lld_erp_manufaktur_pipa_audit_logging", "label": "Audit Trail & Structured Logging", "file_type": "concept", "source_file": "docs/LLD-ERP-Manufaktur-Pipa.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A global Observer writes before/after JSON to audit_logs and the log is append-only with no update or delete endpoint, making it immutable by construction; X-Request-Id correlates frontend, API and queue jobs."}, {"id": "docs_lld_erp_manufaktur_pipa_queue_jobs", "label": "Queue Jobs & Scheduler (default | heavy)", "file_type": "concept", "source_file": "docs/LLD-ERP-Manufaktur-Pipa.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MRP/CRP/COGM runs go to a separate `heavy` queue so long batch computations cannot starve interactive exports and alert jobs on `default`."}, {"id": "docs_lld_erp_manufaktur_pipa_frontend_design", "label": "React Frontend Design (DataTable, DocForm, ScanBox)", "file_type": "concept", "source_file": "docs/LLD-ERP-Manufaktur-Pipa.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One server-side DataTable and one header\u2013detail DocForm are reused by every module so sorting, filtering, dirty-check and optimistic-lock behaviour stay uniform; the sidebar and action buttons are driven by the permission set returned from /auth/me rather than hardcoded per page."}, {"id": "docs_lld_erp_manufaktur_pipa_api_contract", "label": "API Contract (/api/v1 and /api/mes/v1)", "file_type": "concept", "source_file": "docs/LLD-ERP-Manufaktur-Pipa.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RESTful resources plus action endpoints /{id}/{verb}; full contract is generated to OpenAPI 3 from annotations, and the frontend query hooks are auto-generated from that spec to keep client and server in step."}, {"id": "docs_lld_erp_manufaktur_pipa_subcont_flow", "label": "Subcont Flow (PO Subcont \u2192 DN \u2192 Receipt \u2192 AP)", "file_type": "concept", "source_file": "docs/LLD-ERP-Manufaktur-Pipa.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_lld_erp_manufaktur_pipa_deployment", "label": "Deployment & Infrastructure", "file_type": "concept", "source_file": "docs/LLD-ERP-Manufaktur-Pipa.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Migrations must be backward-compatible so blue-green deploys stay zero-downtime; a read replica absorbs report/EIS queries to keep the transactional primary responsive for shop-floor scanning."}, {"id": "docs_lld_erp_manufaktur_pipa_testing_strategy", "label": "Testing Strategy (Pest unit \u2192 Playwright E2E)", "file_type": "concept", "source_file": "docs/LLD-ERP-Manufaktur-Pipa.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unit tests target exactly the engines whose arithmetic is regulation- or money-sensitive (TaxEngine rounding, QuotaService balance, ScrapService threshold, SerialService kg proportion); UAT is driven from the 16 PRD user stories."}, {"id": "docs_lld_erp_manufaktur_pipa_wh_serial_table", "label": "wh_serial / wh_serial_movement / wh_stock_sum Schema", "file_type": "concept", "source_file": "docs/LLD-ERP-Manufaktur-Pipa.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "wh_serial_movement is a per-serial ledger keyed by (ref_type, ref_id) giving full traceability, while wh_stock_sum is a denormalised aggregate maintained by events purely so list screens and MRP do not have to scan the movement ledger."}], "edges": [{"source": "docs_lld_erp_manufaktur_pipa_lld_document", "target": "docs_prd_erp_manufaktur_pipa_prd_document", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/LLD-ERP-Manufaktur-Pipa.md", "source_location": null, "weight": 1.0}, {"source": "docs_lld_erp_manufaktur_pipa_testing_strategy", "target": "docs_prd_erp_manufaktur_pipa_user_stories", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/LLD-ERP-Manufaktur-Pipa.md", "source_location": null, "weight": 1.0}, {"source": "docs_lld_erp_manufaktur_pipa_wh_serial_table", "target": "docs_prd_erp_manufa